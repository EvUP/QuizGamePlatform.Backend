{
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning",
			"Microsoft.EntityFrameworkCore.Database.Command": "Warning"
		}
	},
	"AllowedHosts": "*",
	"ConnectionStrings": {
		"DefaultConnection": "Host=localhost;Port=5450;Database=diplomDB;Username=postgres;Password=secret",
		"Redis": "localhost:6379"
	},

	"Keycloak": {
		"Authority": "http://localhost:8080/realms/DiplomRealm",
		"Audience": "quiz-backend",
		"RequireHttpsMetadata": false,
		"AuthorizationUrl": "http://localhost:8080/realms/DiplomRealm/protocol/openid-connect/auth",
		"TokenUrl": "http://localhost:8080/realms/DiplomRealm/protocol/openid-connect/token"
	},

	"GameSettings": {
		"Roles": {
			"Admin": "game_admin",
			"Moderator": "game_moderator",
			"Player": "game_player"
		}
	}
}
