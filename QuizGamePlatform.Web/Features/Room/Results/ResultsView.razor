@using QuizGamePlatform.Web.Features.Leaderboard
@implements IDisposable
@inject GameSession Session
@inject MatchApiClient MatchApi

@*
    Итоги: командная игра — только команды, обычная — игроки по верным ответам (вышедший до финиша получает 0).
    Места считает сервер, без дележа: равные очки разбиты по времени верных ответов — его и показываем у равных.
*@
<div class="results">
    <div class="hero">
        <span class="chip">Игра окончена@(TotalQuestions is { } total ? $" · {RussianPlural.Format(total, "вопрос", "вопроса", "вопросов")}" : "")</span>
        <h1>@Headline</h1>
        @if (Subline is not null)
        {
            <p>@Subline</p>
        }
    </div>

    @if (entries.Count > 0)
    {
        @* пьедестал и таблица — одна «сцена»: рядом на широком окне, друг под другом на узком *@
        <div class="stage">
            <div class="podium">
                @foreach (var entry in PodiumOrder)
                {
                    <div class="pillar">
                        <span class="pillar-name" title="@entry.Name">@entry.Name</span>
                        <span class="pillar-points">@entry.Points @PointsWord(entry.Points)</span>
                        <div class="block place-@entry.Place" style="--block-color: @entry.Color">
                            <span class="block-place">@entry.Place</span>
                            <span>место</span>
                        </div>
                    </div>
                }
            </div>

            <ol class="table">
                @foreach (var entry in entries)
                {
                    <li class="@(entry.IsMine ? "mine" : null)">
                        <PlaceBadge Place="entry.Place" Large="true" />
                        <span class="info">
                            <span class="name" title="@entry.Name">@entry.Name@(entry.IsMine ? (Room.IsTeamGame ? " · ваша команда" : " · вы") : "")</span>
                            @if (entry.Note is not null)
                            {
                                <span class="note">@entry.Note</span>
                            }
                        </span>
                        <span class="bar"><span style="width: @(entry.Percent)%; background: @entry.Color"></span></span>
                        <span class="points">@entry.Points@if (TieTime(entry) is { } time){<span class="time" title="@TimeHint">@($" · {time}")</span>}</span>
                    </li>
                }
            </ol>
        </div>

        <p class="rule">
            @(Room.IsTeamGame
                ? "За вопрос команда получает столько очков, сколько процентов её игроков ответили верно. При равных очках выше команда, которая в среднем быстрее отвечала верно."
                : "Очко за каждый верный ответ. Кто ушёл до финала, получает 0. При равных очках выше тот, кто быстрее отвечал верно.")
        </p>
    }

    <div class="actions">
        @if (Session.IsHost)
        {
            <a class="primary" href="rooms/new@(Room.IsTeamGame ? "?type=team" : "")">Сыграть ещё</a>
        }
        <a class="secondary" href="leaderboard@(Room.IsTeamGame ? "?tab=team" : "")">Рейтинг</a>
        @if (Room.MatchId is not null)
        {
            <button type="button" class="link review" aria-haspopup="dialog" @ref="reviewButton" @onclick="OpenReviewAsync">Разбор вопросов</button>
        }
        <a class="link" href="">На главную</a>
    </div>
</div>

@if (reviewOpen)
{
    <MatchReview Review="review" Error="reviewError" OnRetry="LoadReviewAsync" OnClose="CloseReviewAsync" />
}

@code {
    [Parameter, EditorRequired]
    public RoomStateResponse Room { get; set; } = default!;

    [Parameter]
    public int? TotalQuestions { get; set; }

    private List<ResultEntry> entries = [];

    // разбор грузим по кнопке и держим, пока открыты итоги
    private readonly LatestRequest reviewRequest = new();
    private ElementReference reviewButton;
    private bool reviewOpen;
    private MatchReviewResponse? review;
    private ApiError? reviewError;

    private string Headline => entries.FirstOrDefault(e => e.Place == 1) switch
    {
        null => "Итоги игры",
        // имя без кавычек: в нём могут быть свои «»
        { } winner when Room.IsTeamGame => $"Побеждает {winner.Name}!",
        { } winner => $"{winner.Name} забирает первое место!"
    };

    private string? Subline
    {
        get
        {
            var mine = entries.FirstOrDefault(e => e.IsMine);

            if (mine is null)
            {
                return null;
            }

            // «на 2-м месте» — окончание одно для любого числа
            var place = mine.Place == 1
                ? (Room.IsTeamGame ? "Ваша команда победила!" : "Вы победили")
                : (Room.IsTeamGame ? $"Ваша команда на {mine.Place}-м месте" : $"Вы на {mine.Place}-м месте");

            return Room.IsTeamGame
                ? place
                : $"{place} · {RussianPlural.Format(mine.Points, "верный ответ", "верных ответа", "верных ответов")}";
        }
    }

    // пьедестал слева направо: 2, 1, 3
    private IEnumerable<ResultEntry> PodiumOrder
    {
        get
        {
            var top = entries.Take(3).ToList();
            return top.Count switch
            {
                3 => [top[1], top[0], top[2]],
                2 => [top[1], top[0]],
                _ => top
            };
        }
    }

    protected override void OnParametersSet() => entries = Room.IsTeamGame ? TeamEntries() : PlayerEntries();

    private List<ResultEntry> TeamEntries()
    {
        var myTeam = Session.Me?.TeamNumber;
        var teams = (Room.Teams ?? []).Where(t => t.Members > 0).OrderBy(t => t.Place ?? int.MaxValue).ToList();
        var max = Math.Max(1, TotalQuestions is { } total ? total * 100 : teams.Max(t => t.Points ?? 0));

        return teams.Select(t => new ResultEntry(
                t.Name,
                t.Points ?? 0,
                t.Place ?? 0,
                $"var(--qg-team-{t.Number})",
                t.Number == myTeam,
                RussianPlural.Format(t.Members, "игрок", "игрока", "игроков"),
                Math.Min(100, (t.Points ?? 0) * 100 / max),
                t.AvgCorrectTimeMs))
            .ToList();
    }

    private List<ResultEntry> PlayerEntries()
    {
        // места с сервера; без них (старый сервер) — просто по порядку
        var players = Room.Players.OrderBy(p => p.Place ?? int.MaxValue).ToList();
        var max = Math.Max(1, TotalQuestions ?? players.Max(p => p.Score ?? 0));

        return players.Select((player, i) =>
            {
                var score = player.Score ?? 0;
                var place = player.Place ?? i + 1;

                return new ResultEntry(
                    player.PlayerName,
                    score,
                    place,
                    place <= 3 ? $"var(--qg-medal-{place})" : "var(--qg-info)",
                    player.RoomPlayerLinkId == Room.MyRoomPlayerLinkId,
                    player.IsActive ? (player.IsGuest ? "гость" : null) : "выход до финала",
                    Math.Min(100, score * 100 / max),
                    player.CorrectTimeMs);
            })
            .ToList();
    }

    private async Task OpenReviewAsync()
    {
        reviewOpen = true;

        if (review?.MatchId != Room.MatchId)
        {
            await LoadReviewAsync();
        }
    }

    private async Task LoadReviewAsync()
    {
        if (Room.MatchId is not { } matchId)
        {
            return;
        }

        review = null;
        reviewError = null;
        var ct = reviewRequest.Next();

        try
        {
            var result = await MatchApi.GetReviewAsync(matchId, ct);

            if (ct.IsCancellationRequested)
            {
                return;
            }

            if (result.IsSuccess)
            {
                review = result.Value;
            }
            else
            {
                reviewError = result.Error;
            }
        }
        catch (OperationCanceledException)
        {
            // ушли с итогов
        }
    }

    // фокус обратно на кнопку, с которой открыли
    private async Task CloseReviewAsync()
    {
        reviewOpen = false;
        StateHasChanged();
        await Task.Yield();
        await reviewButton.FocusAsync();
    }

    public void Dispose() => reviewRequest.Dispose();

    // в обычной игре очко = верный ответ, поэтому подпись одна
    private static string PointsWord(int points) => RussianPlural.Choose(points, "очко", "очка", "очков");

    // время нужно только тем, у кого очки равны с кем-то ещё: по нему их и рассадили
    private string? TieTime(ResultEntry entry)
        => entry.TimeMs is { } ms && entries.Count(e => e.Points == entry.Points) > 1 ? Seconds(ms) : null;

    private string TimeHint => Room.IsTeamGame ? "Среднее время верного ответа" : "Сколько времени ушло на верные ответы";

    // «17,0 с» — запятую ставим сами, не завися от данных культуры в WebAssembly
    private static string Seconds(long ms)
    {
        var tenths = (ms + 50) / 100;
        return $"{tenths / 10},{tenths % 10} с";
    }

    private sealed record ResultEntry(string Name, int Points, int Place, string Color, bool IsMine, string? Note, int Percent, long? TimeMs);
}
