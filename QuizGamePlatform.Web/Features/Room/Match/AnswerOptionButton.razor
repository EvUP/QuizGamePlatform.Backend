@* Вариант ответа A–D. Состояние решает MatchView. *@
<button type="button" class="option @StateClass" style="--letter-color: var(--qg-team-@ColorNumber)"
        disabled="@Disabled" aria-pressed="@(State is OptionState.Selected or OptionState.Wrong ? "true" : "false")"
        @onclick="OnClick">
    <span class="letter" aria-hidden="true">@Letter</span>
    <span class="text">@Text</span>
    @if (State == OptionState.Correct)
    {
        <span class="badge correct"><Icon Name="IconName.Check" Size="16" StrokeWidth="3" />Верный ответ</span>
    }
    else if (State == OptionState.Wrong)
    {
        <span class="badge wrong"><Icon Name="IconName.Close" Size="16" StrokeWidth="3" />Ваш ответ</span>
    }
    else if (State == OptionState.Selected)
    {
        <span class="badge mine">Ваш ответ</span>
    }
</button>

@code {
    [Parameter, EditorRequired]
    public string Letter { get; set; } = "";

    [Parameter, EditorRequired]
    public string Text { get; set; } = "";

    /// <summary>1–4: цвет буквы как у команд</summary>
    [Parameter]
    public int ColorNumber { get; set; } = 1;

    [Parameter]
    public OptionState State { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    private string StateClass => State switch
    {
        OptionState.Selected => "selected",
        OptionState.Dimmed => "dimmed",
        OptionState.Correct => "correct",
        OptionState.Wrong => "wrong",
        _ => ""
    };
}
