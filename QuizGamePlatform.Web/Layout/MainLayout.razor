@inherits LayoutComponentBase

<div class="shell">
    <header class="header">
        <a class="logo" href="" aria-label="QuizGame — на главную">
            <span class="logo-mark" aria-hidden="true">Q</span>
            <span class="logo-text">QuizGame</span>
        </a>
        <nav class="nav" aria-label="Основное меню">
            <NavLink class="nav-link" href="leaderboard">Рейтинг</NavLink>
            <AccountMenu />
        </nav>
    </header>

    <main class="content">
        <ErrorBoundary @ref="errorBoundary">
            @Body
        </ErrorBoundary>
    </main>

    <footer class="footer">
        <span>QuizGame · дипломный проект OTUS</span>
        <span>Blazor WebAssembly · ASP.NET Core · SignalR</span>
    </footer>
</div>

@code {
    private ErrorBoundary? errorBoundary;

    // После перехода на другую страницу сбрасываем показанную ошибку
    protected override void OnParametersSet() => errorBoundary?.Recover();
}
