@* Иконки-обводки 24×24, цвет берут из currentColor. Без Label — декоративные и скрыты от скринридеров. *@
<svg class="icon" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="@StrokeWidth" stroke-linecap="round" stroke-linejoin="round" focusable="false"
     aria-hidden="@(Label is null ? "true" : null)" role="@(Label is null ? null : "img")" aria-label="@Label">
    @switch (Name)
    {
        case IconName.Plus:
            <path d="M12 5v14M5 12h14" />
            break;
        case IconName.User:
            <circle cx="12" cy="8" r="4" />
            <path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" />
            break;
        case IconName.Users:
            <circle cx="8" cy="8" r="3.2" />
            <circle cx="16.5" cy="9" r="2.6" />
            <path d="M2.5 20c1-3.5 3-5.2 5.5-5.2S12.5 16.5 13.5 20M14 15.2c.8-.4 1.6-.6 2.5-.6 2.2 0 3.9 1.5 4.8 4.4" />
            break;
        case IconName.Link:
            <path d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4l-1 1M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1-1" />
            break;
        case IconName.ArrowRight:
            <path d="M5 12h14M13 6l6 6-6 6" />
            break;
        case IconName.Alert:
            <circle cx="12" cy="12" r="10" />
            <path d="M12 7v6M12 16.5v.5" />
            break;
        case IconName.CheckCircle:
            <circle cx="12" cy="12" r="10" />
            <path d="M7.5 12.5l3 3 6-6.5" />
            break;
        case IconName.Check:
            <path d="M5 12.5l4.5 4.5L19 7.5" />
            break;
        case IconName.Trash:
            <path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3" />
            break;
        case IconName.Crown:
            <path d="M3 8l4.5 4L12 5l4.5 7L21 8l-2 11H5L3 8z" />
            break;
        case IconName.Pencil:
            <path d="M4 20h4L19 9l-4-4L4 16v4zM13.5 6.5l4 4" />
            break;
        case IconName.Close:
            <path d="M6 6l12 12M18 6L6 18" />
            break;
        case IconName.Copy:
            <rect x="8" y="8" width="12" height="12" rx="2" />
            <path d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3" />
            break;
        case IconName.Play:
            <path d="M7 4.5v15l13-7.5z" />
            break;
        case IconName.ChevronLeft:
            <path d="M15 5l-7 7 7 7" />
            break;
        case IconName.WifiOff:
            <path d="M2 8.5a15 15 0 0 1 5-3M22 8.5a15 15 0 0 0-8.5-4.4M5 12a10 10 0 0 1 3.5-2.2M19 12a10 10 0 0 0-2.5-1.8M8.5 15.5a5 5 0 0 1 7 0M12 19h.01M3 3l18 18" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public IconName Name { get; set; }

    [Parameter]
    public int Size { get; set; } = 20;

    [Parameter]
    public double StrokeWidth { get; set; } = 2.2;

    /// <summary>Текст для скринридера, если иконка несёт смысл сама по себе</summary>
    [Parameter]
    public string? Label { get; set; }
}
