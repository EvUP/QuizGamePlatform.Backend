@inherits CountdownBase

@* Кольцо таймера вопроса. Последние 5 секунд — коралловое. *@
<div class="ring @(Urgent ? "urgent" : null) @(Muted ? "muted" : null)"
     style="--size: @(Size)px" role="timer" aria-label="@($"Осталось {SecondsLeft} с")">
    <svg viewBox="0 0 100 100" aria-hidden="true">
        <circle class="track" cx="50" cy="50" r="44" />
        <circle class="progress" cx="50" cy="50" r="44" pathLength="100"
                stroke-dasharray="100" stroke-dashoffset="@DashOffset" />
    </svg>
    <span class="value">
        <span class="number">@SecondsLeft</span>
        @if (Caption is not null)
        {
            <span class="caption">@Caption</span>
        }
    </span>
</div>

@code {
    /// <summary>Полная длительность — для доли кольца</summary>
    [Parameter]
    public int TotalSeconds { get; set; } = 30;

    [Parameter]
    public int Size { get; set; } = 120;

    [Parameter]
    public string? Caption { get; set; }

    /// <summary>Серое кольцо — например, в показе ответа</summary>
    [Parameter]
    public bool Muted { get; set; }

    private bool Urgent => !Muted && RemainingSeconds <= 5;

    private string DashOffset
        => (100 * (1 - Math.Clamp(RemainingSeconds / Math.Max(1, TotalSeconds), 0, 1)))
            .ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
}
