{
  "realm": "quizgame",
  "enabled": true,
  "displayName": "QuizGame",
  "loginTheme": "keycloak.v2",
  "internationalizationEnabled": true,
  "supportedLocales": ["ru"],
  "defaultLocale": "ru",
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "keycloak@corp.local",
    "fromDisplayName": "Корпоративный квиз"
  },
  "editUsernameAllowed": false,
  "clients": [
    {
      "clientId": "quiz-backend",
      "name": "Quiz Game Backend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://localhost:53506/swagger/oauth2-redirect.html",
        "http://localhost:53507/swagger/oauth2-redirect.html",
        "http://localhost:5200/authentication/*",
        "https://localhost:7200/authentication/*"
      ],
      "webOrigins": [
        "https://localhost:53506",
        "http://localhost:53507",
        "http://localhost:5200",
        "https://localhost:7200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost:53506/swagger/index.html##http://localhost:53507/swagger/index.html##http://localhost:5200/authentication/*##https://localhost:7200/authentication/*"
      },
      "protocolMappers": [
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "quiz-backend",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
    }
  ]
}
